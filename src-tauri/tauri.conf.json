{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kite Mail",
  "version": "0.5.2",
  "identifier": "com.tlr.kitemail",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kite Mail",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Lightweight email client",
    "category": "Productivity"
  }
}
